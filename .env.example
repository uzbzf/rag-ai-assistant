# Google AI Studio API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding & Chat Models
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Global RAG Sources (Google Docs URLs or IDs -> exported as .docx, Google Sheets URL or ID -> exported as .xlsx)
# Leave empty to use local rag-docs/*.docx and rag-docs/schedule.xlsx
RAG_PRICE_LIST_DOC_ID=
RAG_FAQ_DOC_ID=
RAG_SCHEDULE_SHEET_ID=
ENROLLMENT_SHEET_ID=

# Optional: Google Cloud Console Service Account (only needed if Google Docs/Sheets are PRIVATE, not shared by link)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
